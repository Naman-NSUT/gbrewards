# Origin of the Dealer Rewards API. No trailing slash. The client appends /api/v1.
# Leave blank to call the same origin the site is served from (useful behind a proxy).
VITE_API_BASE_URL=http://localhost:8000

# Optional. Shown on the "we could not find it" and claim screens so a stuck
# customer has a human to reach. Omit either one and that line simply disappears
# rather than showing a placeholder nobody answers.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
