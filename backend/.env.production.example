# Production backend env (set these as Render service env vars, NOT committed).
ENV=prod
# Provided by Render managed resources:
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/DB
REDIS_URL=redis://HOST:6379/0
# Strong secret (Render can generateValue). Must be >= 32 chars.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
# Comma-separated allowed origins for the admin web (required in prod/staging):
CORS_ORIGINS=https://admin.yourdomain.com
# OTP: must be 'msg91' in prod (DLT-registered). 'fake' allowed only in dev/staging.
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
# Anti-abuse
SCAN_RATE_PER_MIN=30
# Error monitoring (optional; leave blank to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
